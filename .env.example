# ===========================================
# TallerDB - Variables de Entorno
# Copia este archivo a .env y modifica los valores
# ===========================================

# --- Base de Datos ---
# Desarrollo local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Producción (MySQL/MariaDB) - descomenta y configura:
# DATABASE_URL=mysql+asyncmy://taller:tallerpass@localhost:3306/tallerdb

# --- MySQL (para Docker Compose) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=tallerdb
MYSQL_USER=taller
MYSQL_PASSWORD=tallerpass

# --- Seguridad ---
# GENERA UNA CLAVE SEGURA: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production-min-32-characters-long
SESSION_COOKIE_NAME=session

# --- Aplicación ---
APP_NAME=TallerDB
DEBUG=true

# --- Usuario Administrador (creado automáticamente al iniciar) ---
# Cambia estos valores en producción ANTES del primer deploy
ADMIN_EMAIL=admin@tallerdb.local
ADMIN_PASSWORD=admin123
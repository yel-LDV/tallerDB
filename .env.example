# ===========================================
# TallerDB - Variables de Entorno
# Copia este archivo a .env y modifica los valores
# ===========================================

# --- Base de Datos ---
# Motores soportados: sqlite | mysql | mariadb | postgresql
# Si la base configurada no responde, la aplicación NO arranca
# (excepto SQLite, que crea el archivo local si hace falta).
DATABASE_TYPE=mariadb

# Tiempo máximo (segundos) para comprobar la conexión al arrancar.
DATABASE_CONNECT_TIMEOUT=10

# --- MariaDB (local con ./startdb.sh o contenedor) ---
# Con ./startdb.sh la instancia se crea en .mariadb/ (datos, socket y logs).
# Host 127.0.0.1 para conexiones TCP; el script usa 127.0.0.1 por defecto.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=taller
MARIADB_PASSWORD=tallerpass
MARIADB_DATABASE=tallerdb
MARIADB_CHARSET=utf8mb4

# Rutas opcionales de la instancia local (valores por defecto entre paréntesis):
# MARIADB_LOCAL_DIR=./.mariadb      # carpeta raíz de datos/run/log
# MARIADB_DATA_DIR=./.mariadb/data
# MARIADB_RUN_DIR=./.mariadb/run
# MARIADB_LOG_DIR=./.mariadb/log
# MARIADB_SOCKET=./.mariadb/run/mariadb.sock
# MARIADB_PID_FILE=./.mariadb/run/mariadb.pid

# --- MySQL (alternativa a MariaDB) ---
# DATABASE_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=taller
# MYSQL_PASSWORD=tallerpass
# MYSQL_DATABASE=tallerdb
# MYSQL_CHARSET=utf8mb4

# --- PostgreSQL ---
# DATABASE_TYPE=postgresql
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=taller
# POSTGRES_PASSWORD=tallerpass
# POSTGRES_DATABASE=tallerdb
# POSTGRES_SSLMODE=prefer   # ejemplo: require para servidores gestionados

# --- SQLite (desarrollo rápido, sin servidor) ---
# DATABASE_TYPE=sqlite
# SQLITE_PATH=./dev.db

# --- URL completa (máxima prioridad) ---
# Si se define, ignora DATABASE_TYPE y el resto de variables del motor.
# Se aceptan esquemas síncronos y se convierten al driver async.
# DATABASE_URL=postgresql://taller:tallerpass@localhost:5432/tallerdb
# DATABASE_URL=mysql://taller:tallerpass@localhost:3306/tallerdb
# DATABASE_URL=sqlite:///./dev.db

# --- Credenciales para Docker Compose ---
MARIADB_ROOT_PASSWORD=rootpass
# POSTGRES_PASSWORD=tallerpass
# MYSQL_ROOT_PASSWORD=rootpass

# --- Seguridad ---
# GENERA UNA CLAVE SEGURA: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production-min-32-characters-long
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE_DAYS=7
# Actívalo solo cuando la app se sirva directamente por HTTPS.
FORCE_HTTPS=false
# Hosts permitidos cuando DEBUG=false (separados por coma).
ALLOWED_HOSTS=localhost,127.0.0.1,*.tallerdb.local

# --- Aplicación ---
APP_NAME=TallerDB
# false en Docker/producción; true solo para desarrollo local (reload)
DEBUG=false

# --- Archivos 3D (GLB) ---
UPLOADS_DIR=./uploads
MAX_3D_SIZE_MB=25

# --- Usuario Administrador (lo crea scripts/create_admin.py) ---
# Cambia estos valores en producción ANTES del primer deploy
ADMIN_EMAIL=admin@tallerdb.local
ADMIN_PASSWORD=admin123
